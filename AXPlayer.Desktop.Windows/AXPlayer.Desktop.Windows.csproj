<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AXPlayer</AssemblyName>
    <Product>AX Player</Product>
    <AssemblyTitle>AX Player</AssemblyTitle>
    <Copyright>Copyright (c) 2026 ZeroMayo</Copyright>
    <ApplicationIcon>nekoplayer_app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Tmds.DBus.Tool" Version="0.7.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\AXPlayer.App\AXPlayer.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="AXPlayerTrayIconExtraStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AXPlayerTrayIconExtraStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="AXPlayerTrayIconExtraStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AXPlayerTrayIconExtraStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="appIcon.bmp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="avcodec-63.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
